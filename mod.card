{
  "title": "Gen1Follower",
  "summary": "All 251 Gen 1 and Gen 2 overworld followers with Gold, Crystal 251 and voxel/tilt compatibility.",
  "author": "wild1walker",
  "version": "1.6.0",
  "tags": [
    "graphics",
    "followers",
    "ui"
  ],
  "features": [
    "All 251 Gen 1 and Gen 2 Pokémon overworld sprites supported",
    "Native GSC-style Generation II follower sheets without HGSS downscaling",
    "Automatic Crystal 251 species detection",
    "Pokédex-proportional follower sizes with safe visual limits",
    "Party Slot 1 default follower with automatic lead switching",
    "Party Menu 'FOLLOW?' UI option for explicit follower selection",
    "Party Menu 'FOLLOWER' toggle to walk with no follower at all",
    "Full-color GBA overworld graphics over colorized terrain",
    "Red, Blue and Gold follower spawning without Yellow-only story flags",
    "Animated overworld walking frames enabled for all follower sprites",
    "Gen1Recomp 0.1.86+ sandbox-compatible bootstrap and scoped asset paths",
    "Map Pokémon drawn from the same 251 sheets, not the cart's shared ones"
  ],
  "description": "All 251 Gen 1 and Gen 2 overworld followers with Crystal 251 and Dramatic Shape voxel/tilt compatibility for Red, Blue, Yellow, and Gold. Version 1.6.0 keeps a map Pokémon off the black beside the game: a sprite whose cell is outside the visible area queued a redraw the renderer replays in screen space, so it painted next to the picture instead of being clipped with everything else. On top of 1.5.1's follower landing in the right square out of a door, 1.5.0's every-follower-at-its-own-art-size default, 1.3.0's map Pokémon wearing the follower sheets, and 1.2.1's unlit-cave darkening and 1.2.0's party-menu toggle for walking with no follower at all.",
  "credits": [
    {
      "who": "Antigravity & gamecorner33",
      "for_": "PokePC Followers (mfrtechconsult/PokePCFollowers), the codebase this mod is built from -- its follower mechanics, fixes and compatibility work are all still here"
    },
    {
      "who": "ShockSlayer and the Pokemon Crystal Clear team",
      "for_": "the GSC-style overworld follower art the Generation II sheets descend from"
    },
    {
      "who": "the PokePC / Followers EX lineage",
      "for_": "the follower-sprite lineage those sheets come through"
    },
    {
      "who": "Wilds of Kanto (YoDrehDenSwagAuf/overworld-spawn-mod)",
      "for_": "the Poke Followers pack the Generation II sheets are distributed in"
    },
    {
      "who": "Gen1Recomp",
      "for_": "the renderer, party and sandbox seams this mod hooks"
    }
  ]
}
